{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dossier",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "PROFILE_CACHE",
      "id": "85db57f791a34403af6d73d4da165793"
    }
  ],
  "ratelimits": [
    {
      "name": "PROFILE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    // Non-secret configuration. Secrets (APIFY_TOKEN, GITHUB_TOKEN)
    // are set with `wrangler secret put <NAME>`.
    "CACHE_TTL_SECONDS": "2592000",
    "RATE_LIMIT_MAX": "30",
    "RATE_LIMIT_WINDOW_SECONDS": "600",
    "PROVIDER_TIMEOUT_MS": "9000",
    "APIFY_TIMEOUT_MS": "90000",
    "ENABLE_DEMO_PROVIDER": "true"
  }
}
