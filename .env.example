# Copy to .env.local for `next dev`. In production set secrets with `wrangler secret put`.

# Apify Console → Settings → API & Integrations. LinkedIn profiles are fetched
# by harvestapi/linkedin-profile-scraper (no-email mode). This spends Apify credit.
APIFY_TOKEN=
# APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-scraper
# APIFY_TIMEOUT_MS=55000

# Optional: raises GitHub API quota for the enrichment provider.
GITHUB_TOKEN=

ENABLE_DEMO_PROVIDER=true
