# Copy to .env.local for `next dev`. In production set these with `wrangler secret put`.

# Licensed vendor APIs (either or both). Without them, only Wikidata-backed (notable) people resolve.
PDL_API_KEY=
RAPIDAPI_KEY=
# RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data.p.rapidapi.com

# Optional: raises GitHub API quota for the enrichment provider.
GITHUB_TOKEN=

# Operator opt-in. See README before enabling.
ENABLE_PUBLIC_PAGE_PROVIDER=false
ENABLE_DEMO_PROVIDER=true
